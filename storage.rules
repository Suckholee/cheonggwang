rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{uid}/{pageId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // 견적 요청 사진: 작성한 본인만 read (업로드 직후 getDownloadURL 호출용).
    // 외부 공유는 getDownloadURL 이 반환한 signed token URL 을 통해서만 가능.
    match /quote-photos/{uid}/{requestId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // v1.1b #3 provider-profile-editor — 청명 프로필 사진 (공개 읽기)
    match /profile-images/{uid}/{pageId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // v1.1b #3 provider-profile-editor — Before/After 포트폴리오 사진 (공개 읽기)
    match /work-photos/{uid}/{workCaseId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // v1.6 community-feed-3panel — 고객 스크랩북 원본 사진.
    // v1.7 P8: customer-story 패널은 제거됐으나 스크랩북은 v2까지 유지 (design §10 M16).
    // 공개 읽기 · 업로더만 쓰기 · 5MB 상한 · image 타입.
    match /stories/{uid}/{storyId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // v1.7 partner-promo — 의뢰업체(B2B 파트너) 홍보글 원본 사진.
    // 공개 읽기 (OG/생성 이미지로 사용) · 업로더(파트너 본인)만 쓰기 · 5MB · image 타입.
    match /partners/{uid}/{postId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
